# ==============================================================================
# ChartSense AI - Environment Configuration Template (.env.example)
# AI-Powered Trading Chart Scanner with Exness Referral-Based Access
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE SETTINGS (Mandatory)
# ------------------------------------------------------------------------------
APP_NAME="ChartSense AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ------------------------------------------------------------------------------
# 2. LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE CONFIGURATION (Mandatory)
# Manageable through pgAdmin 4:
# Host: 127.0.0.1, Port: 5432, Maintenance DB: postgres or chartsense_db
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chartsense_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# ------------------------------------------------------------------------------
# 4. SESSION, CACHE, & QUEUE DRIVERS (Mandatory)
# PostgreSQL stores sessions, cache locks, and queued AI scanning jobs.
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# 5. EXNESS REFERRAL VERIFICATION (Mandatory)
# Scanner access is locked until the user's Exness referral is verified.
# Official Exness Referral Link:
# ------------------------------------------------------------------------------
EXNESS_REFERRAL_URL="https://one.exnessonelink.com/a/l4l2nsdkfb?source=app"
REFERRAL_VERIFICATION_MODE=manual_review
# Options: 'manual_review' (admin reviews account ID & evidence) or 'official_api'

# ------------------------------------------------------------------------------
# 6. MULTI-AI VISION & REASONING PROVIDER CONFIGURATION
# Supported providers: 'gemini', 'claude', 'openai', 'deepseek', 'deterministic'
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_gemini_or_default_ai_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# OpenAI GPT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# DeepSeek Reasoning Engine
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 7. SCANNER UPLOAD LIMITS & SETTINGS
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=15
ALLOWED_IMAGE_EXTENSIONS="png,jpg,jpeg,webp"
ALLOWED_CSV_EXTENSIONS="csv"

# ------------------------------------------------------------------------------
# 8. OPTIONAL LIVE MARKET DATA PROVIDER
# If left empty, scanner operates in User-Supplied Mode (Images & CSV).
# ------------------------------------------------------------------------------
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

# ------------------------------------------------------------------------------
# 9. OPTIONAL TELEGRAM NOTIFICATIONS BOT
# Used for real-time referral verification & scan alerts.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ------------------------------------------------------------------------------
# 10. MAIL CONFIGURATION (Optional for local development)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="support@chartsense.ai"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 11. FRONTEND ASSETS
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 12. GOOGLE OAUTH CONFIGURATION
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ------------------------------------------------------------------------------
# 13. FIREBASE CONFIGURATION
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyBh7NeBrf1FTrTHIpMDvJpWwCafmjt0zzo"
VITE_FIREBASE_AUTH_DOMAIN="attendance-app-fd219.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="attendance-app-fd219"
VITE_FIREBASE_STORAGE_BUCKET="attendance-app-fd219.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="488465672551"
VITE_FIREBASE_APP_ID="1:488465672551:web:62f1435cef3ab32ae167c2"
VITE_FIREBASE_MEASUREMENT_ID="G-XKFQYQTHZX"
